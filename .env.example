DB_BACKEND=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=krug_pi
MYSQL_USER=krug_pi_app
MYSQL_PASSWORD=

# true when the site is served over HTTPS
COOKIE_SECURE=false

# Optional email delivery; configure a real HTTPS website URL accessible to students.
SITE_URL=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# IANA timezone used by the lesson calendar and dashboards.
LESSON_TIMEZONE=Europe/Moscow
# Main timezone for the administrator; student fallback remains LESSON_TIMEZONE.
ADMIN_TIMEZONE=Europe/Berlin

# Google Drive archives: create an OAuth Web application in Google Cloud.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=http://127.0.0.1:8000/api/admin/archive-settings/callback
# Optional: private persistent directory outside landing/dist (default: data/google-drive).
# GOOGLE_DRIVE_PRIVATE_DIR=
